<?xml version="1.0" ?>
<robot name="autonomous_drone">
  <link name="box_body"> 
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".18 .18 .141" />
      </geometry>
      <material name="Blue">
        <color rgba=".2588 .5294 .9608 .7"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder size="1.8 1.8 1.41" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_right">
    <visual>
      <origin xyz="0.103 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius = "0.04" length = ".019" />
      </geometry>
      <material name="Black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0.103 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius = "0.04" length = ".019" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_left" >
    <visual>
      <origin xyz="-0.103 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder radius = "0.04" length = ".019" />
      </geometry>
      <material name="Black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="-0.103 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder radius = "0.04" length = ".019" />
      </geometry>
    </collision>
  </link>

  <link name="imu" >
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".5 .5 .5" />
      </geometry>
      <material name="Green">
        <color rgba="0 .3686 .0196 0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.8 1.41" />
      </geometry>
    </collision>
  </link>

  <link name="lidar" >
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".5 .5 .5" />
      </geometry>
      <material name="Black">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.8 1.41" />
      </geometry>
    </collision>
  </link>

  <link name="ball_caster" >
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".5 .5 .5" />
      </geometry>
      <material name="Blue">
        <color rgba=".2588 .5294 .9608 0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.8 1.41" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="box_body"/>
    <child link="wheel_right"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="box_body"/>
    <child link="wheel_left"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="box_body"/>
    <child link="imu"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="box_body"/>
    <child link="lidar"/>
  </joint>

  <joint name="ball_joint" type="fixed">
    <parent link="box_body"/>
    <child link="ball_caster"/>
  </joint>
</robot>